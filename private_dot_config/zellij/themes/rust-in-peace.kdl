// rust-in-peace — Megadeth "Rust in Peace" cover palette.
// Component structure follows zellij's built-in tokyo-night theme;
// the active-accent role is the cover's electric tube blue rather
// than green, so pane frames and the selected tab stay calm.
// Companion to ~/.config/helix/themes/rust-in-peace.toml
//
// bg #101530 · fg #d3e0f0 · cyan #83c2fc · green #8cf25c · orange #ffc46b
// red #fa7a52 · pink #f77cb3 · purple #b592f7 · yellow #fcee7e
themes {
    rust-in-peace {
        text_unselected {
            base 211 224 240
            background 28 37 71
            emphasis_0 255 196 107
            emphasis_1 131 194 252
            emphasis_2 140 242 92
            emphasis_3 181 146 247
        }
